{
  "document_types": {
    "CUSTOMER_PO": {
      "description": "Purchase Order issued by customer (buyer)",
      "fields": {
        "po_number": "string",
        "po_date": "string",
        "customer_name": "string",
        "billing_address": "string",
        "shipping_address": "string",
        "total_amount": "number",
        "currency": "string",
        "payment_terms": "string",
        "gst_number": "string"
      }
    },
    "COMPANY_DC": {
      "description": "Delivery Challan issued by company to dispatch goods",
      "fields": {
        "dc_number": "string",
        "dc_date": "string",
        "po_reference": "string",
        "sales_order_no": "string",
        "customer_order_date": "string",
        "customer_name": "string",
        "items_description": "string",
        "quantity": "number",
        "dispatch_to": "string",
        "est_amount": "number"
      }
    },
    "COMPANY_INVOICE": {
      "description": "Tax Invoice issued by company to bill the customer",
      "fields": {
        "invoice_number": "string",
        "invoice_date": "string",
        "po_reference": "string",
        "customer_order_date": "string",
        "so_number": "string",
        "acct_manager": "string",
        "customer_name": "string",
        "subtotal": "number",
        "tax_amount": "number",
        "total_amount": "number",
        "irn_number": "string"
      }
    },
    "VENDOR_DC": {
      "description": "Delivery Challan from vendor/supplier",
      "fields": {
        "dc_number": "string",
        "dc_date": "string",
        "po_reference": "string",
        "vendor_name": "string",
        "items_description": "string",
        "quantity": "number",
        "vehicle_number": "string",
        "receiver_name": "string"
      }
    },
    "VENDOR_INVOICE": {
      "description": "Tax Invoice from vendor/supplier",
      "fields": {
        "invoice_number": "string",
        "invoice_date": "string",
        "po_reference": "string",
        "vendor_name": "string",
        "subtotal": "number",
        "tax_amount": "number",
        "total_amount": "number",
        "payment_terms": "string",
        "gst_number": "string",
        "irn_number": "string",
        "ack_number": "string",
        "ack_date": "string"
      }
    },
    "COMPANY_PO": {
      "description": "Purchase Bill issued by company to record vendor purchase",
      "fields": {
        "po_number": "string",
        "po_date": "string",
        "bill_no": "string",
        "bill_date": "string",
        "vendor_name": "string",
        "subtotal": "number",
        "tax_amount": "number",
        "total_amount": "number"
      }
    },
    "POD": {
      "description": "Proof of Delivery document",
      "fields": {
        "pod_number": "string",
        "delivery_date": "string",
        "received_by": "string",
        "dc_reference": "string",
        "po_reference": "string",
        "delivery_location": "string",
        "condition_notes": "string",
        "signature_present": "boolean"
      }
    }
  },

  "notes": {
    "mandatory_fields": ["invoice_number", "dc_number", "po_number", "po_reference", "so_number/sales_order_no"],
    "known_ocr_issues": {
      "I_vs_1": "OCR reads 1ITR as 11TR, 1ISR as 11SR, 1OTM as 10TM (font renders I/O similar to 1/0)",
      "reference_confusion": "On Company DCs, OCR confuses 'Reference' (person name) with 'Customer Order No.' (po_reference)",
      "multi_page_totals": "For multi-page DCs (5-6 pages), totals only appear on the last page"
    }
  },

