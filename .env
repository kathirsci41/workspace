# Database
DATABASE_URL=postgresql+asyncpg://docplatform:docplatform@localhost:5432/docplatform
SYNC_DATABASE_URL=postgresql://docplatform:docplatform@localhost:5432/docplatform

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
NAS_BASE_PATH=/nas/documents

# OCR
OCR_BASE_URL=http://localhost:11434
OCR_MODEL_NAME=glm-ocr
OCR_TIMEOUT=1200000
OCR_MAX_RETRIES=3
OCR_PDF_DPI=200
OCR_MAX_PAGES=10

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Debug
DEBUG=true
