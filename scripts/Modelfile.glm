FROM glm-ocr

# CRITICAL FIX: Default context causes garbled/empty output on real documents
# Increase to handle multi-page invoices and dense tables
PARAMETER num_ctx 16384

# Deterministic output — essential for OCR, never want randomness
PARAMETER temperature 0

# Stop tokens for clean output
PARAMETER stop "<|endoftext|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|assistant|>"
