# Database
DATABASE_URL=postgresql+asyncpg://docplatform:docplatform@localhost:5433/docplatform
SYNC_DATABASE_URL=postgresql://docplatform:docplatform@localhost:5433/docplatform

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (local path or NAS mount)
NAS_BASE_PATH=/path/to/storage/documents

# OCR – Ollama (Layer 1: GLM-OCR, local)
OCR_BASE_URL=http://localhost:11434
OCR_MODEL_NAME=glm-ocr
OCR_TIMEOUT=1200
OCR_MAX_RETRIES=3
OCR_PDF_DPI=200
OCR_MAX_PAGES=1

# Two-layer OCR pipeline (GLM-OCR → gemma3:12b extraction)
OCR_TWO_LAYER_ENABLED=true
OCR_CUSTOM_MODEL=glm-ocr:latest
OCR_EXTRACTOR_MODEL=gemma3:12b
OCR_EXTRACTOR_NUM_CTX=8192
OCR_SAVE_DEBUG_MARKDOWN=false

# Cloud extractor for Layer 2 — leave blank to use local Ollama
OCR_EXTRACTOR_BASE_URL=
OCR_EXTRACTOR_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Debug
DEBUG=true
